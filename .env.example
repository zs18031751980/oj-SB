# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，请勿提交真实密钥。
# start.sh 会加载本文件同名变量，未设置项使用本地开发默认值。

# ---------- 数据存储 ----------
OJ_DB_URL=jdbc:postgresql://127.0.0.1:5432/oj
OJ_DB_USERNAME=oj
OJ_DB_PASSWORD=oj
OJ_DB_POOL_SIZE=10

OJ_REDIS_HOST=127.0.0.1
OJ_REDIS_PORT=6379
OJ_REDIS_PASSWORD=

# ---------- 服务地址 ----------
OJ_API_PORT=6173
# 绑定地址：本地开发建议 127.0.0.1；容器内由 docker-compose 设为 0.0.0.0
OJ_BIND_ADDRESS=127.0.0.1
OJ_FRONTEND_URL=http://127.0.0.1:5173
OJ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ---------- 认证 ----------
# 必须设置为至少 32 位的随机串；留空或使用仓库占位值会导致启动失败
OJ_JWT_SECRET=
OJ_JWT_ISSUER=letcoding
OJ_JWT_AUDIENCE=letcoding-api
OJ_ACCESS_TTL_SECONDS=900
OJ_REFRESH_TTL_SECONDS=604800
OJ_COOKIE_SECURE=false
# 第三方 OAuth2 密码模式；如无必要建议关闭，仅使用授权码流程
OJ_OAUTH_PASSWORD_GRANT_ENABLED=true
# 仅这些供应商的角色声明可影响本地角色；为空时新用户一律 member
OJ_OAUTH_TRUSTED_ROLE_PROVIDERS=
# 是否允许可信供应商直接授予 manager（默认 false，最多 staff，管理员走本地授权）
OJ_OAUTH_ALLOW_MANAGER_FROM_PROVIDER=false

# ---------- 判题 ----------
# 生产：关闭本机执行，使用 Judge0；本地开发如无 Judge0，需显式改为 true + local（无沙箱，风险自负）
OJ_ALLOW_LOCAL_JUDGE=false
OJ_JUDGE_ENABLED=true
OJ_JUDGE_EXECUTOR=judge0
OJ_JUDGE0_ENABLED=true
OJ_JUDGE0_URL=http://127.0.0.1:2358

# ---------- 监控与代理 ----------
# 生产必须配置随机令牌；未配置时监控端点默认返回 503
METRICS_TOKEN=
OJ_METRICS_ALLOW_ANONYMOUS=false
# 仅当服务位于会覆盖 X-Forwarded-For 的可信代理之后才开启
OJ_TRUST_FORWARDED_FOR=false
# 可信代理地址（逗号分隔）；配置后仅接受这些对端的转发头
OJ_TRUSTED_PROXIES=
# 匿名执行接口在限流组件故障时是否拒绝（默认拒绝）
OJ_RATE_LIMIT_PUBLIC_FAIL_CLOSED=true

# ---------- 本地开发测试账号（默认不创建） ----------
# 仅开发环境显式开启；角色默认 member，可选 member/staff/manager
OJ_SEED_DEV_ACCOUNT=false
OJ_SEED_DEV_ROLE=member

# ---------- 学习资料根目录（默认指向前端 learn_source） ----------
# OJ_LEARN_ROOT=/absolute/path/to/learn_source

# ---------- OAuth 提供方（可选；逗号分隔，需与下面变量对应） ----------
# OJ_OAUTH_PROVIDERS=iOSClub,github
# OJ_OAUTH_PKCE=false

# iOSClub (OIDC)
# OJ_OAUTH_IOSCLUB_CLIENT_ID=
# OJ_OAUTH_IOSCLUB_CLIENT_SECRET=
# OJ_OAUTH_IOSCLUB_ISSUER=https://api.xauat.site
# OJ_OAUTH_IOSCLUB_SCOPE=openid profile role
# OJ_OAUTH_IOSCLUB_REDIRECT_URI=http://127.0.0.1:6173/auth/callback/iOSClub

# GitHub OAuth
# OJ_OAUTH_GITHUB_CLIENT_ID=
# OJ_OAUTH_GITHUB_CLIENT_SECRET=
# OJ_OAUTH_GITHUB_AUTHORIZATION_URI=https://github.com/login/oauth/authorize
# OJ_OAUTH_GITHUB_TOKEN_URI=https://github.com/login/oauth/access_token
# OJ_OAUTH_GITHUB_USERINFO_URI=https://api.github.com/user
# OJ_OAUTH_GITHUB_SCOPE=read:user user:email
# OJ_OAUTH_GITHUB_REDIRECT_URI=http://127.0.0.1:6173/auth/callback/github
